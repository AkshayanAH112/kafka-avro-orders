{
  "type": "record",
  "name": "Order",
  "namespace": "com.abde.orders",
  "doc": "A single purchase transaction emitted by the order producer.",
  "fields": [
    {
      "name": "orderId",
      "type": "string",
      "doc": "Unique identifier for the order (e.g. \"1001\", \"1002\")."
    },
    {
      "name": "product",
      "type": "string",
      "doc": "Name of the purchased item (e.g. \"Item1\", \"Item2\")."
    },
    {
      "name": "price",
      "type": "float",
      "doc": "Price of the product (randomised for the assignment)."
    }
  ]
}
